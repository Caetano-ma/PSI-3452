* Oscilador com VDD = 2.10 V
.lib "C:/Users/caean/EDA/pdk/sky130A/libs.tech/ngspice/sky130.lib.spice" tt
.include "../../blocos/oscilador.spice"
VDD vdd 0 2.10
X1 vdd clk oscilador
XSW 0 clk 0 0 sky130_fd_pr__nfet_g5v0d10v5 W=20 L=0.5 nf=1 m=10
.ic v(x1.r1)=0 v(x1.r2)=2.10 v(x1.r3)=0 v(x1.r4)=2.10 v(x1.r5)=0
.control
tran 5n 300u uic
meas tran t1 when v(clk)=1.05 rise=4
meas tran t2 when v(clk)=1.05 rise=8
meas tran tf when v(clk)=1.05 fall=4
meas tran q integ i(VDD) from=t1 to=t2
let freq = 4/(t2-t1)
let ton = tf-t1
let pw = -q/(t2-t1)*2.10
echo RESULT 2.10 $&freq $&ton $&pw
quit
.endc
.end
